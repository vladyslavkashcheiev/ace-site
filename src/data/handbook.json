 "rules": [
  {
   "n": "I",
   "title": "Общие положения",
   "items": [
    "Подразделение ACE (Army Compartmented Elements) — специализированное звено Армии, ответственное за перевозку боеприпасов и грузов, эксплуатацию военной техники, безопасность складов, дисциплину и порядок в подразделении.",
    "Устав обязателен для всех военнослужащих ACE. Незнание положений не освобождает от ответственности."
   ]
  },
  {
   "n": "II",
   "title": "Субординация",
   "items": [
    "ACE подчиняется командованию Армии.",
    "Приказы командиров обязательны к исполнению.",
    "Обсуждение приказов разрешено только после выполнения."
   ]
  },
  {
   "n": "III",
   "title": "Дисциплина",
   "items": [
    "Каждый военнослужащий обязан соблюдать военную дисциплину.",
    "Запрещено употребление алкоголя, наркотиков, азартные игры и любые действия, нарушающие порядок."
   ]
  },
  {
   "n": "IV",
   "title": "Бараки и быт",
   "items": [
    "Ответственным за порядок является дежурный ACE.",
    "Каждое место должно быть в чистоте.",
    "Нарушение порядка влечёт штрафы и выговоры."
   ]
  },
  {
   "n": "V",
   "title": "Форма одежды",
   "items": [
    "Форма обязана соответствовать уставным нормам.",
    "Гражданская одежда на службе запрещена.",
    "Самовольное изменение формы влечёт наказание."
   ]
  },
  {
   "n": "VI",
   "title": "Оружие и боеприпасы",
   "items": [
    "Хранение и выдача оружия осуществляется по приказу.",
    "Самовольный вынос оружия запрещён.",
    "Использование без приказа — грубое нарушение."
   ]
  },
  {
   "n": "VII",
   "title": "Грузовые машины",
   "items": [
    "Перед выездом проверяется техническое состояние.",
    "Личное использование техники запрещено.",
    "Сокрытие поломок — тяжёлое нарушение."
   ]
  },
  {
   "n": "VIII",
   "title": "Складское имущество",
   "items": [
    "Склад охраняется и доступен только по приказу.",
    "Запрещено перемещать имущество без разрешения.",
    "Ответственный фиксирует все операции."
   ]
  },
  {
   "n": "IX",
   "title": "Перевозки боеприпасов",
   "items": [
    "Все перевозки проходят только под охраной.",
    "Колонна движется единым маршрутом.",
    "Самовольное отклонение — нарушение."
   ]
  },
  {
   "n": "X",
   "title": "Боевые дежурства",
   "items": [
    "Личный состав обязан прибывать вовремя.",
    "Сон на посту запрещён.",
    "Самовольный уход влечёт арест."
   ]
  },
  {
   "n": "XI",
   "title": "Учебные занятия",
   "items": [
    "Обязательны для всего состава.",
    "Прогулы без уважительных причин запрещены.",
    "Отказ выполнять задания — нарушение дисциплины."
   ]
  },
  {
   "n": "XII",
   "title": "Медицинское обеспечение",
   "items": [
    "Все военнослужащие проходят медосмотр.",
    "Запрещено скрывать болезни.",
    "Игнорирование врачебных предписаний карается."
   ]
  },
  {
   "n": "XIII",
   "title": "Радиосвязь",
   "items": [
    "Радио используется только по службе.",
    "Ложные сведения строго запрещены.",
    "Нарушение радиодисциплины — грубое нарушение."
   ]
  },
  {
   "n": "XIV",
   "title": "Секретность",
   "items": [
    "Данные о перевозках и складах являются секретом.",
    "Разглашение приравнивается к предательству.",
    "Виновные несут наказание вплоть до отстранения."
   ]
  },
  {
   "n": "XV",
   "title": "Взаимоотношения в подразделении",
   "items": [
    "Запрещены оскорбления, драки, издевательства.",
    "Старшие заботятся о младших.",
    "Нарушение устава взаимоотношений ведёт к взысканию."
   ]
  },
  {
   "n": "XVI",
   "title": "КПП и охрана территории",
   "items": [
    "КПП охраняется круглосуточно.",
    "Запрещено пропускать посторонних без приказа.",
    "Сон на КПП или отвлечение — серьёзное нарушение."
   ]
  },
  {
   "n": "XVII",
   "title": "Поведение с гражданскими",
   "items": [
    "Военнослужащий обязан вести себя корректно.",
    "Запрещено применять оружие без оснований.",
    "Конфликты с гражданскими запрещены."
   ]
  },
  {
   "n": "XVIII",
   "title": "Взаимодействие с другими подразделениями",
   "items": [
